{
  "hooks": {
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/delivery_check.sh",
            "timeout": 3600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/hooks/token_usage.py\"; [ -f \"$p\" ] && exec python3 \"$p\" --hook || exit 0",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/hooks/budget_guard.py\"; [ -f \"$p\" ] && exec python3 \"$p\" || exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/hooks/token_usage.py\"; [ -f \"$p\" ] && exec python3 \"$p\" --hook || exit 0",
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/hooks/token_usage.py\"; [ -f \"$p\" ] && exec python3 \"$p\" --hook || exit 0",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/hooks/token_usage.py\"; [ -f \"$p\" ] && exec python3 \"$p\" --hook || exit 0",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/hooks/clone_reuse_guard.py\"; [ -f \"$p\" ] && exec python3 \"$p\" || exit 0",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/hooks/history_guard.py\"; [ -f \"$p\" ] && exec python3 \"$p\" || exit 0",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/hooks/watchdog.py\"; [ -f \"$p\" ] && exec python3 \"$p\" || exit 0",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/hooks/framework_edit_guard.py\"; [ -f \"$p\" ] && exec python3 \"$p\" || exit 0",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/hooks/history_guard.py\"; [ -f \"$p\" ] && exec python3 \"$p\" || exit 0",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/hooks/loop_guard.py\"; [ -f \"$p\" ] && exec python3 \"$p\" || exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
